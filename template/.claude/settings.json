{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/dp-guard.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(lib/**)",
      "Write(lib/**)",
      "Edit(app/**)",
      "Write(app/**)",
      "Edit(pkg/**)",
      "Write(pkg/**)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(scripts/prepare-delegation.sh:*)",
      "Bash(scripts/set-status.sh:*)",
      "Bash(scripts/new-feature.sh:*)",
      "Bash(scripts/doctor.sh:*)",
      "Bash(scripts/status.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
