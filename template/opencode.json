{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "implementer",
  "instructions": ["AGENTS.md", "docs/constitution.md"],
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "permission": {
    "edit": {
      "*": "allow",
      "docs/**": "deny",
      "docs/specs/*/reports/**": "allow",
      "CLAUDE.md": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      ".claude/**": "deny",
      ".opencode/**": "deny",
      ".github/**": "deny",
      ".env*": "deny",
      "package.json": "deny",
      "package-lock.json": "deny",
      "pnpm-lock.yaml": "deny",
      "yarn.lock": "deny",
      "Cargo.toml": "deny",
      "Cargo.lock": "deny",
      "go.mod": "deny",
      "go.sum": "deny",
      "pyproject.toml": "deny",
      "requirements.txt": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git stash*": "deny",
      "git merge*": "deny",
      "rm -rf*": "deny",
      "sudo*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "npm install*": "deny",
      "npm i *": "deny",
      "pnpm add*": "deny",
      "yarn add*": "deny",
      "pip install*": "deny",
      "cargo add*": "deny",
      "go get*": "deny",
      "ls*": "allow",
      "cat*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "npx*": "allow",
      "pnpm test*": "allow",
      "pnpm run*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "go test*": "allow",
      "go build*": "allow",
      "go vet*": "allow",
      "make test*": "allow",
      "make lint*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
